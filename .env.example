# ==============================================================================
# SmartHire X - Environment Configuration Template
# ==============================================================================

# Server & Port Configuration
SERVER_PORT=8080
PORT=8080

# AI Provider Configuration (gemini, heuristic, or openai)
AI_PROVIDER=gemini

# Google Gemini API Key (for Response Generation & Semantic Embeddings)
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_google_gemini_api_key_here
GOOGLE_API_KEY=your_google_gemini_api_key_here
AI_API_KEY=your_google_gemini_api_key_here

# Pinecone Vector Database (for 768-dim Vector Embeddings & Similarity Retrieval)
# Obtain from Pinecone Console: https://app.pinecone.io/
PINECONE_API_KEY=your_pinecone_api_key_here
PINECONE_INDEX_NAME=ai-rag-documents
PINECONE_ENVIRONMENT=us-east-1
PINECONE_NAMESPACE=default
PINECONE_HOST=

# JWT Secret (minimum 256-bit hex or base64 string)
JWT_SECRET=404E635266556A586E3272357538782F413F4428472B4B6250645367566B5970
JWT_EXPIRATION_MS=86400000

# GitHub Integration & OAuth (Optional)
GITHUB_CLIENT_ID=your_github_client_id
GITHUB_CLIENT_SECRET=your_github_client_secret
GITHUB_CALLBACK_URL=http://localhost:8080/student/github

# Database Configuration (Spring Data JPA)
# Uses local H2 by default (jdbc:h2:file:./data/smarthiredb); override for external MySQL / PostgreSQL:
# MYSQL_URL=jdbc:mysql://localhost:3306/smarthire_db?createDatabaseIfNotExist=true&useSSL=false&allowPublicKeyRetrieval=true&serverTimezone=UTC
# MYSQL_USER=root
# MYSQL_PASSWORD=root
